import os
import requests
import subprocess
import logging

logging.basicConfig(level=logging.INFO, format="%(message)s")

class CodeReviewPy:
    def __init__(self):
        self.git_api_url = os.getenv("GIT_API_URL", "https://git.abcorg.com/api/v3")
        self.repo = os.getenv("PR_REPO_NAME")        # from webhook
        self.pr_number = os.getenv("PR_NUMBER")      # from webhook
        self.token = os.getenv("GIT_TOKEN")          # Jenkins secret
        if not all([self.repo, self.pr_number, self.token]):
            raise RuntimeError("Missing PR_REPO_NAME, PR_NUMBER, or GIT_TOKEN")

    def get_pr_files(self):
        """Fetch changed files from the PR"""
        url = f"{self.git_api_url}/repos/{self.repo}/pulls/{self.pr_number}/files"
        headers = {"Authorization": f"token {self.token}"}
        logging.info(f"Fetching PR files from {url}")
        r = requests.get(url, headers=headers)
        r.raise_for_status()
        return [f["filename"] for f in r.json()]

    def validate_python_file(self, file_path):
        """Run pylint on a file"""
        cmd = ["pylint", file_path, "--score=no"]
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=False)
            output = result.stdout + result.stderr
            if result.returncode == 0:
                status = "PASSED"
            else:
                status = "FAILED"
        except FileNotFoundError:
            status = "ERROR"
            output = "pylint not found in container"
        return status, output

    def run_validation(self):
        py_files = [f for f in self.get_pr_files() if f.endswith(".py")]
        if not py_files:
            logging.info("No Python files changed in this PR.")
            return True

        all_passed = True
        for f in py_files:
            logging.info(f"\n--- Validating {f} ---")
            status, output = self.validate_python_file(f)
            logging.info(output)
            logging.info(f"Result: {status}")
            if status != "PASSED":
                all_passed = False

        return all_passed


if __name__ == "__main__":
    validator = CodeReviewPy()
    success = validator.run_validation()
    if not success:
        exit(1)  # Fail Jenkins build
